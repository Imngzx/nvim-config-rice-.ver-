{
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "${3rd}/luv/library",
      "/usr/share/nvim/runtime/lua"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": [
      "vim",
      "bit",
      "jit"
    ],
    "disable": [
      "lowercase-global",
      "undefined-global",
      "undefined-doc-name",
      "undefined-field",
      "return-type-mismatch",
      "missing-return",
      "param-type-mismatch",
      "cast-local-type",
      "assign-type-mismatch"
    ]
  },
  "format": {
    "enable": true
  },
  "hint": {
    "enable": true,
    "arrayIndex": "Disable",
    "await": true,
    "paramName": "All",
    "paramType": true,
    "semicolon": "Disable",
    "setType": true
  }
}
